{
  "name": "orbital-marketplace-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "python3 ../scripts/generate_frontend_data.py",
    "dev": "npm run data && node scripts/build-hero-glb.mjs && node scripts/render-featured-products.mjs && vite --host 0.0.0.0",
    "build": "npm run data && node scripts/build-hero-glb.mjs && node scripts/render-featured-products.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "npm run data && tsc --noEmit",
    "hero:build": "node scripts/build-hero-glb.mjs",
    "products": "node scripts/render-featured-products.mjs",
    "products:force": "FORCE_PRODUCT_RENDER=1 python3 ../scripts/generate_frontend_data.py && FORCE_PRODUCT_RENDER=1 node scripts/render-featured-products.mjs",
    "prerender": "node scripts/prerender.mjs",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "4.4.0",
    "@lottiefiles/dotlottie-web": "0.83.2",
    "@pmndrs/assets": "1.7.0",
    "@tanstack/react-virtual": "3.14.26",
    "clsx": "2.1.1",
    "geist": "1.9.2",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "lucide-react": "1.77.0",
    "minisearch": "7.2.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
