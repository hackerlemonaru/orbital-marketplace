# secrets — never commit
.secrets/
.env
.env.*
!.env.example
*.pem
*.key
.netrc
.git-credentials

# build / deps
node_modules/
.next/
dist/
build/
out/
.turbo/
*.tsbuildinfo
.wrangler/

# large binary corpus lives in R2, not git
asset-corpus/
*.glb
*.gltf
*.spz
*.sog
*.ply
*.hdr
*.exr
*.zip
!seed-assets/**/*.glb
!seed-assets/**/*.webp
# small hero assets deliberately served from GitHub raw
!website/models/**/*.glb
!website/models/**/*.gltf
!website/models/**/*.md
!website/models/**/*.txt
!website/shaders/**/*.glsl
!website/shaders/**/*.txt

# python caches
__pycache__/
*.pyc
