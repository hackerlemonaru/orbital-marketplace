{
  "name": "orbital-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Web-native 3D, motion and UI-decoration asset marketplace with a rate-limited AI agent surface.",
  "notes": "Dependency skeleton only - versions are 'latest' intentionally; pin to a lockfile after the first install. Reflects the stack chosen in github-seed-assets-stack-plan.md (Nov 2026).",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed:import": "tsx scripts/import-seed.ts",
    "assets:validate": "tsx scripts/validate-assets.ts",
    "assets:optimize": "tsx scripts/optimize-assets.ts",
    "agent:mcp": "tsx scripts/mcp-server.ts",
    "feed:build": "tsx scripts/build-product-feed.ts"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "@react-three/fiber": "latest",
    "@react-three/drei": "latest",
    "motion": "latest",
    "gsap": "latest",
    "lenis": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/postcss": "latest",
    "shadcn": "latest",
    "drizzle-orm": "latest",
    "@neondatabase/serverless": "latest",
    "stripe": "latest",
    "@upstash/redis": "latest",
    "@upstash/ratelimit": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "zod": "latest",
    "c2pa": "latest",
    "@gltf-transform/core": "latest",
    "@gltf-transform/extensions": "latest",
    "@gltf-transform/functions": "latest",
    "@lottiefiles/dotlottie-react": "latest",
    "typescript": "latest"
  },
  "devDependencies": {
    "tsx": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "drizzle-kit": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright": "latest"
  },
  "licenseGates": {
    "allow": ["CC0-1.0", "MIT", "MIT-0", "CC-BY-4.0", "Apache-2.0"],
    "requireAttribution": ["CC-BY-4.0"],
    "deny": ["Commons Clause", "CC-BY-NC", "CC-BY-NC-SA", "NOASSERTION", "GPL-3.0", "proprietary-no-redistribution"]
  }
}
